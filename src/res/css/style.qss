/* ============================================================
   Light Pink Theme — QSS Stylesheet for PyQt7
   ============================================================ */

/* ---------- Base ---------- */
QWidget {
    background-color: #FFF5F8;
    color: #3A1729;
    font-size: 13px;
}

QWidget#chatPanel {
    background-color: #FFF5F8;
    color: #3A1729;
    font-size: 13px;
}

QMainWindow {
    background-color: #FFF5F8;
}

/* ---------- Surfaces ---------- */
QGroupBox, QFrame#card {
    background-color: #FDE9F0;
    border: 1px solid #F3B8D2;
    border-radius: 8px;
    margin-top: 10px;
    padding: 8px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 8px;
    padding: 0 4px;
    color: #7A4A63;
}

QDialog {
    background-color: #FBD9E7;
}

/* ---------- Labels ---------- */
QLabel {
    color: #3A1729;
    background: transparent;
}

QLabel#secondary {
    color: #7A4A63;
}

QLabel#disabled {
    color: #B591A3;
}

/* ---------- Buttons ---------- */

QPushButton {
    background-color: #FF5C9E;
    color: #FFF5F8;
    border: 1px solid #FF5C9E;
    border-radius: 6px;
    padding: 6px 16px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #E64B8A;
}

QPushButton:pressed {
    background-color: #C93E76;
}

QPushButton:disabled {
    background-color: #F3B8D2;
    color: #B591A3;
}

/* Secondary / muted button — set objectName("secondaryButton") */
QPushButton#secondaryButton {
    background-color: #FFD6E8;
    color: #3A1729;
}

QPushButton#secondaryButton:hover {
    background-color: #FF8FBC;
}

/* ---------- Line edits / text inputs ---------- */
QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: #FFFFFF;
    color: #3A1729;
    border: 1px solid #F3B8D2;
    border-radius: 6px;
    padding: 6px 8px;
    selection-background-color: #FF8FBC;
    selection-color: #3A1729;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border: 1px solid #FF5C9E;
}

QLineEdit:disabled {
    background-color: #FDE9F0;
    color: #B591A3;
}

/* ---------- Checkboxes / radio buttons ---------- */
QCheckBox, QRadioButton {
    color: #3A1729;
    spacing: 6px;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #F3B8D2;
    background-color: #FFFFFF;
}

QCheckBox::indicator {
    border-radius: 4px;
}

QRadioButton::indicator {
    border-radius: 8px;
}

QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background-color: #FF5C9E;
    border: 1px solid #FF5C9E;
}

/* ---------- ComboBox ---------- */
QComboBox {
    background-color: #FFFFFF;
    border: 1px solid #F3B8D2;
    border-radius: 6px;
    padding: 4px 8px;
    color: #3A1729;
}

QComboBox:hover {
    border: 1px solid #FF8FBC;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #F3B8D2;
    selection-background-color: #FFD6E8;
    selection-color: #3A1729;
    outline: none;
}

/* ---------- Tabs ---------- */
QTabWidget::pane {
    border: 1px solid #F3B8D2;
    background-color: #FDE9F0;
    border-radius: 6px;
}

QTabBar::tab {
    background-color: #FBD9E7;
    color: #7A4A63;
    padding: 6px 14px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background-color: #FF5C9E;
    color: #FFF5F8;
}

QTabBar::tab:hover:!selected {
    background-color: #FFD6E8;
}

/* ---------- Scrollbars ---------- */
QScrollBar:vertical {
    background: #FDE9F0;
    width: 10px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #F3B8D2;
    border-radius: 5px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: #FF8FBC;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background: #FDE9F0;
    height: 10px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: #F3B8D2;
    border-radius: 5px;
    min-width: 24px;
}

QScrollBar::handle:horizontal:hover {
    background: #FF8FBC;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

/* ---------- Progress bar ---------- */
QProgressBar {
    background-color: #FDE9F0;
    border: 1px solid #F3B8D2;
    border-radius: 6px;
    text-align: center;
    color: #3A1729;
}

QProgressBar::chunk {
    background-color: #FF5C9E;
    border-radius: 6px;
}

/* ---------- Sliders ---------- */
QSlider::groove:horizontal {
    background: #F3B8D2;
    height: 4px;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background: #FF5C9E;
    width: 14px;
    height: 14px;
    margin: -5px 0;
    border-radius: 7px;
}

QSlider::handle:horizontal:hover {
    background: #E64B8A;
}

/* ---------- Menu / menu bar ---------- */
QMenuBar {
    background-color: #FDE9F0;
    color: #3A1729;
}

QMenuBar::item:selected {
    background-color: #FFD6E8;
}

QMenu {
    background-color: #FFFFFF;
    border: 1px solid #F3B8D2;
    color: #3A1729;
}

QMenu::item:selected {
    background-color: #FFD6E8;
}

/* ---------- Status bar ---------- */
QStatusBar {
    background-color: #FDE9F0;
    color: #7A4A63;
}

/* ---------- Tooltips ---------- */
QToolTip {
    background-color: #3A1729;
    color: #FFF5F8;
    border: none;
    padding: 4px 8px;
    border-radius: 4px;
}

/* ---------- Functional states (apply via dynamic property "state") ---------- */
/* Usage: widget.setProperty("state", "success" | "warning" | "error" | "info") */
QLabel[state="success"] { color: #4CAF7D; }
QLabel[state="warning"] { color: #E8A93C; }
QLabel[state="error"]   { color: #E85D5D; }
QLabel[state="info"]    { color: #3FA9B5; }

/* ---------- Scroll Area / Chat Panel specifics ---------- */
QScrollArea#chatScrollArea {
    background-color: #F3B8D2;
}
